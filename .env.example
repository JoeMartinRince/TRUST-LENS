# TrustLens Backend — Environment Variables
# Copy this file to .env and fill in your actual keys.

# Primary Gemini API key (used for LLM synthesis of forensic findings)
GEMINI_API_KEY=

# Fail-safe / Fallback Gemini API key (used automatically if primary key hits rate limit or quota)
GEMINI_API_KEY_FALLBACK=

# Alternatively, a comma-separated list of keys:
# GEMINI_API_KEYS=key1,key2,key3

# Hugging Face Inference API token (used for AI image & deepfake audio detection)
# Get yours at https://huggingface.co/settings/tokens
HF_API_TOKEN=

