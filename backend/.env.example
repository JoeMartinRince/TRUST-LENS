# Primary Gemini API Key
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Fail-Safe Fallback Gemini API Key (Used automatically if Primary key hits rate limits or quota)
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# Optional: Hugging Face API Token (For AI image/video/audio detector models)
HF_API_TOKEN=your_huggingface_api_token_here
